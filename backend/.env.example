SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

FIREBASE_PROJECT_ID=your-gcp-project-id
# Modal/Render: paste minified JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
# Local only: path to your downloaded key file (do not commit this file).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

GEMINI_API_KEY=your-gemini-api-key-from-aistudio-google-com
GEMINI_MODEL=gemini-3.8-flash

# Hindi narration (DeepSeek). Context preview still uses Gemini if GEMINI_API_KEY is set.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
NARRATION_PROVIDER=deepseek

# Production Modal uses modal. Local Docker and the Render rollback use local.
# Legacy GCP API used cloud_run.
PIPELINE_EXECUTION_MODE=local

# Modal application guard. Keep this below the workspace's $30 hard limit.
# The workspace billing limit is authoritative; this estimate is defense in depth.
MODAL_APP_NAME=manhwa-video-backend
MODAL_WORKER_FUNCTION_NAME=process-job
MODAL_WORKER_TIMEOUT_SECONDS=7200
MODAL_WORKER_CPU=2
MODAL_WORKER_MEMORY_MIB=10240
MODAL_HEARTBEAT_INTERVAL_SECONDS=30
MODAL_LEASE_SECONDS=180
MODAL_MONTHLY_COMPUTE_BUDGET_USD=27.50
MODAL_JOB_ADMISSION_COST_USD=0.50
MAX_PIPELINE_STARTS_PER_USER_DAY=5

# Legacy Cloud Run only (optional)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
VERTEX_LOCATION=europe-west1
CLOUD_RUN_JOB_NAME=manhwa-pipeline
CLOUD_RUN_JOB_TIMEOUT_SECONDS=7200

MAX_PDF_BYTES=52428800
MAX_PIPELINE_STARTS_GLOBAL_MONTH=150
MAX_PENDING_UPLOADS_PER_USER=2
MAX_PENDING_UPLOADS_GLOBAL=5
NARRATION_BATCH_SIZE=12
TTS_CONCURRENCY=4
# paddle is implemented. rapid is reserved for a later RapidOCR swap.
OCR_ENGINE=paddle

# Comma-separated exact frontend origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://manhwa-five.vercel.app
STORAGE_SIGNED_URL_TTL_SECONDS=7200
