SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

GROQ_API_KEY=your-groq-key

# Use local for Docker Compose. The deployed API must use cloud_run.
PIPELINE_EXECUTION_MODE=local
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-north1
CLOUD_RUN_JOB_NAME=manhwa-pipeline
CLOUD_RUN_JOB_TIMEOUT_SECONDS=7200
MAX_PDF_BYTES=52428800
MAX_PIPELINE_STARTS_PER_USER_30D=3
MAX_PIPELINE_STARTS_GLOBAL_30D=10
MAX_PENDING_UPLOADS_PER_USER=2
MAX_PENDING_UPLOADS_GLOBAL=5

# These three values must identify the same public Cognito app client used by
# the frontend. Do not add an app client secret to browser or backend config.
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=eu-north-1_EXAMPLE
COGNITO_APP_CLIENT_ID=exampleclientid
# Optional: set this only if the pool overview shows the updated issuer type.
# COGNITO_ISSUER=https://issuer-cognito-idp.eu-north-1.amazonaws.com/eu-north-1_EXAMPLE

# Comma-separated exact frontend origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_SIGNED_URL_TTL_SECONDS=7200
